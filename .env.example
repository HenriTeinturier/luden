# Copier en .env. Les secrets et chemins personnels ne sont jamais versionnés.
POSTGRES_USER=luden
POSTGRES_PASSWORD=change-me
POSTGRES_DB=luden
POSTGRES_PORT=5434
DATABASE_URL="postgresql://luden:change-me@127.0.0.1:5434/luden?schema=public"

# Racine ABSOLUE, hors dépôt. Exemple : C:/Users/vous/OneDrive/Luden
# Luden crée uniquement le sous-dossier media. Laisser vide pour démarrer sans images.
LUDEN_DATA_DIR=""

# Facultatif : recherche IGDB. L'ajout manuel fonctionne sans ces identifiants.
IGDB_CLIENT_ID=""
IGDB_CLIENT_SECRET=""

# Serveur local uniquement, y compris après compilation.
HOST=127.0.0.1
PORT=3000
