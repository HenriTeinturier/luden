# Copier en .env AVANT npm install. Ne jamais partager ce fichier une fois rempli.
# PostgreSQL local via compose.yaml. Utiliser des lettres/chiffres/_ pour user et DB.
POSTGRES_USER=luden
POSTGRES_PASSWORD=change-me
POSTGRES_DB=luden
POSTGRES_PORT=5434
DATABASE_URL="postgresql://luden:change-me@127.0.0.1:5434/luden?schema=public"

# Racine ABSOLUE, hors dépôt, choisie par vous. Exemple Windows : C:/LudenData
# Exemple Linux/macOS : /home/vous/LudenData. OneDrive est facultatif.
# Sous-dossiers : media (images), cache (miniatures), backups (archives et travail).
# Laisser vide pour démarrer sans images ni sauvegarde complète.
# Changer ce chemin ne déplace pas les fichiers existants : voir README.
LUDEN_DATA_DIR=""

# Facultatif : autre dossier ABSOLU pour le cache (ex. C:/LudenCache).
# Vide = LUDEN_DATA_DIR/cache. Ne pas placer dans media ou backups.
LUDEN_CACHE_DIR=""

# Limite en Mio des sauvegardes : images + dump, archive reçue et contenu extrait.
# 10240 = 10 Gio ; plage 1 à 102400. Prévoir plusieurs fois cet espace libre.
LUDEN_BACKUP_MAX_MB=10240

# Facultatif : recherche IGDB. L'ajout manuel fonctionne sans ces identifiants.
IGDB_CLIENT_ID=""
IGDB_CLIENT_SECRET=""

# Serveur local uniquement, y compris après compilation.
HOST=127.0.0.1
PORT=3000
