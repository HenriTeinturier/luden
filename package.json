{
  "name": "luden",
  "version": "0.2.0",
  "description": "Une vie de jeux, des souvenirs et des collections réelles ou rêvées. Application locale en français.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenriTeinturier/luden.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "start": "node --env-file=.env .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "verify:release": "tsx scripts/verify-release.ts",
    "db:up": "docker compose up -d --wait",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "media:organize": "tsx scripts/organize-media.ts",
    "media:organize:apply": "tsx scripts/organize-media.ts --apply",
    "postinstall": "prisma generate",
    "format": "prettier --write src scripts tests docs prisma *.md *.json *.ts *.js *.yaml",
    "format:check": "prettier --check src scripts tests docs prisma *.md *.json *.ts *.js *.yaml"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "dotenv": "^17.2.3",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "tar": "^7.5.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "nitro": "3.0.260903-beta",
    "prettier": "^3.9.9",
    "prisma": "6.19.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.3.5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
