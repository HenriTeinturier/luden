generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id              String           @id @default(cuid())
  name            String           @default("Ma vie de joueur")
  games           Game[]
  machines        Machine[]
  collections     Collection[]
  media           Media[]
  categories      GameCategory[]
  platformVisuals PlatformVisual[]
  platforms       Platform[]
  createdAt       DateTime         @default(now())
}

model Platform {
  id                String             @id
  name              String
  shortName         String
  family            String
  color             String
  era               String
  igdbId            Int?               @unique
  games             Game[]
  wishedGames       GameWishPlatform[]
  visuals           PlatformVisual[]
  slideshowEnabled  Boolean            @default(false)
  slideshowSeconds  Int                @default(8)
  customization     Json               @default("{}")
  ownerId           String?
  owner             Profile?           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  catalogPlatformId String?
  catalogPlatform   Platform?          @relation("PlatformCatalog", fields: [catalogPlatformId], references: [id], onDelete: Restrict)
  personalPlatforms Platform[]         @relation("PlatformCatalog")
  isDraft           Boolean            @default(false)

  @@index([ownerId, isDraft])
}

enum PlatformVisualKind {
  BANNER
  POSTER
  LOGO
  BACKGROUND
  HARDWARE
  SIDEBAR_LOGO
  SIDEBAR_BACKGROUND
  SIDEBAR_HARDWARE
}

model PlatformVisual {
  id         String             @id @default(cuid())
  ownerId    String
  owner      Profile            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  platformId String
  platform   Platform           @relation(fields: [platformId], references: [id], onDelete: Cascade)
  kind       PlatformVisualKind
  path       String             @unique
  width      Int
  height     Int
  caption    String             @default("")
  active     Boolean            @default(false)
  isDefault  Boolean            @default(false)
  position   Int                @default(0)
  createdAt  DateTime           @default(now())

  @@index([ownerId, platformId, kind, position])
}

model Machine {
  id      String  @id @default(cuid())
  name    String
  ownerId String
  owner   Profile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  games   Game[]

  @@unique([ownerId, name])
}

model Game {
  id            String             @id @default(cuid())
  ownerId       String
  owner         Profile            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  platformId    String
  platform      Platform           @relation(fields: [platformId], references: [id])
  machineId     String?
  machine       Machine?           @relation(fields: [machineId], references: [id], onDelete: SetNull)
  title         String
  categoryId    String?
  category      GameCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  releaseYear   Int?
  developer     String             @default("")
  publisher     String             @default("")
  genres        String[]           @default([])
  summary       String             @default("")
  igdbId        Int?
  sourceUrl     String?
  discover      Boolean            @default(false)
  souvenir      Boolean            @default(false)
  desire        Float?
  favorite      Boolean            @default(false)
  presentation  Json               @default("{}")
  coverId       String?
  cover         Media?             @relation(fields: [coverId], references: [id], onDelete: SetNull)
  experience    Experience?
  possessions   Possession[]
  media         MediaAttachment[]
  links         GameLink[]
  entries       CollectionEntry[]
  wishPlatforms GameWishPlatform[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([ownerId, platformId])
  @@index([categoryId])
  @@index([ownerId, updatedAt])
}

// Alternative platforms for one shared wish. Experience and ownership stay on Game.platformId.
model GameWishPlatform {
  gameId     String
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  platformId String
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Restrict)

  @@id([gameId, platformId])
  @@index([platformId])
}

model GameCategory {
  id       String  @id @default(cuid())
  ownerId  String
  owner    Profile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name     String
  position Int
  games    Game[]

  @@index([ownerId, position])
}

model Experience {
  id     String     @id @default(cuid())
  gameId String     @unique
  game   Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  status PlayStatus @default(UNPLAYED)
  rating Float?
  memory String     @default("")
  period String     @default("")
}

enum PlayStatus {
  UNPLAYED
  PLAYED
  PLAYING
  FINISHED
  ABANDONED
}

model Possession {
  id     String            @id @default(cuid())
  gameId String
  game   Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  format PossessionFormat
  state  PossessionState   @default(CURRENT)
  store  String            @default("")
  media  MediaAttachment[]
}

enum PossessionFormat {
  PHYSICAL
  DIGITAL
}

enum PossessionState {
  CURRENT
  PAST
}

model Collection {
  id          String            @id @default(cuid())
  ownerId     String
  owner       Profile           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String            @default("")
  kind        CollectionKind
  visibility  Visibility        @default(PRIVATE)
  entries     CollectionEntry[]
  createdAt   DateTime          @default(now())

  @@index([ownerId])
}

enum CollectionKind {
  REAL
  DREAM
}

enum Visibility {
  PRIVATE
  MEMBERS
  UNLISTED
  PUBLIC
}

model CollectionEntry {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  gameId       String
  game         Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now())

  @@id([collectionId, gameId])
}

model Media {
  id          String            @id @default(cuid())
  ownerId     String
  owner       Profile           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  path        String            @unique
  mimeType    String
  width       Int
  height      Int
  sourceUrl   String?
  source      MediaSource       @default(UPLOAD)
  createdAt   DateTime          @default(now())
  games       Game[]
  attachments MediaAttachment[]
}

enum MediaSource {
  UPLOAD
  EXTERNAL_URL
  IGDB
}

enum MediaCategory {
  COVER
  SCREENSHOT
  BOX
  MEDIA
  DOCUMENT
  ADVERTISEMENT
  OTHER
}

// Exactly one context (game or owned copy), enforced by the SQL migration.
model MediaAttachment {
  id           String        @id @default(cuid())
  mediaId      String
  media        Media         @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  gameId       String?
  game         Game?         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  possessionId String?
  possession   Possession?   @relation(fields: [possessionId], references: [id], onDelete: Cascade)
  category     MediaCategory @default(COVER)
  position     Int           @default(0)
  caption      String        @default("")
  isPrimary    Boolean       @default(false)

  @@unique([gameId, mediaId])
  @@unique([possessionId, mediaId])
  @@index([gameId, position])
  @@index([possessionId, position])
}

enum LinkType {
  VIDEO
  REVIEW
  ARTICLE
  GUIDE
  OTHER
}

model GameLink {
  id       String   @id @default(cuid())
  gameId   String
  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  url      String
  title    String   @default("")
  type     LinkType @default(OTHER)
  position Int      @default(0)

  @@index([gameId, position])
}
